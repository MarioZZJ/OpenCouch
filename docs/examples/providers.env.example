# Copy into apps/backend/.env locally. Never commit real credentials.
# Choose the region matching your DashScope API key and model availability.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Control tasks: risk assessment, triage, extraction and session summaries.
LLM_PROVIDER=qwen
LLM_MODEL=qwen-flash
# User-facing text model tiers are independent from control and voice.
RESPONSE_FAST_LLM_PROVIDER=deepseek
RESPONSE_FAST_LLM_MODEL=deepseek-flash
RESPONSE_QUALITY_LLM_PROVIDER=qwen
RESPONSE_QUALITY_LLM_MODEL=qwen-plus
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=45
# Optional paid/native search on supported Qwen text models. False by default.
QWEN_ENABLE_SEARCH=false

# Persistent semantic memory. Switching an existing embedding model requires re-embedding.
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

# Experimental native speech-to-speech. Replace WORKSPACE_ID before enabling.
OPENCOUCH_VOICE_PROVIDER=qwen
OPENCOUCH_ENABLE_EXPERIMENTAL_QWEN_VOICE=false
QWEN_REALTIME_MODEL=qwen3.5-omni-flash-realtime
QWEN_REALTIME_VOICE=Tina
QWEN_REALTIME_VAD=semantic_vad
QWEN_REALTIME_URL=https://WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1/webrtc/realtime
# Add region/model-supported voice IDs only, separated by commas.
QWEN_REALTIME_EXTRA_VOICES=

# Existing OpenCouch persistence settings for host-side development.
OPENCOUCH_PERSISTENCE_BACKEND=postgres
OPENCOUCH_MEMORY_DATABASE_URL=postgresql://opencouch:opencouch@localhost:5432/opencouch
# Set a stable random value in your local environment for restart-safe safety proofs.
VOICE_SAFETY_SIGNING_SECRET=
